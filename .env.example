# BFF Gateway (server-side proxy target for /api/bff rewrites)
BFF_BASE_URL=http://localhost:8080

# Public BFF URL used by browser client (defaults to /api/bff proxy)
NEXT_PUBLIC_BFF_BASE_URL=/api/bff

# SIWE domain must match BFF SIWE_DOMAIN
NEXT_PUBLIC_SIWE_DOMAIN=predix.local
NEXT_PUBLIC_SIWE_URI=http://localhost:3000

# Default chain for wallet connection
NEXT_PUBLIC_DEFAULT_CHAIN_ID=1

# PrediX CTF (Polygon Amoy = 80002) — Phase 5
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CTF_OPS_ADDRESS=
NEXT_PUBLIC_CTF_ADDRESS=
NEXT_PUBLIC_COLLATERAL_TOKEN=
NEXT_PUBLIC_DEMO_CONDITION_ID=
NEXT_PUBLIC_INDEXER_URL=http://localhost:8081
NEXT_PUBLIC_CTF_USE_DEMO=true

# Polling intervals (ms)
NEXT_PUBLIC_ORDERBOOK_POLL_MS=5000
NEXT_PUBLIC_ORDERS_POLL_MS=8000

# Dev-only mock order book fallback (BFF 502/empty → market-schema orders)
NEXT_PUBLIC_USE_MOCK_ORDERBOOK=false
NEXT_PUBLIC_MARKET_SCHEMA_URL=http://localhost:8081

# Auto-open auth welcome on first visit (true = auth only, skip HowItWorks auto-open)
# NEXT_PUBLIC_AUTO_AUTH_WELCOME=true
